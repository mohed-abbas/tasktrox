# ===========================================
# CLOUDFLARE R2 BACKUP CREDENTIALS
# ===========================================
# Deployed to: /home/murx/shared/.env.backup
#
# Used by scripts/backup.sh for off-site backup uploads.
# If these are not set, backups are stored locally only.
#
# To get these values:
#   1. Cloudflare Dashboard → R2 Object Storage → Manage R2 API Tokens
#   2. Create an API token with "Object Read & Write" permissions
#   3. Create a bucket (e.g., "vps-backups")

R2_BUCKET=vps-backups
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
