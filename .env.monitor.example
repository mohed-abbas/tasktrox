# ===========================================
# DISCORD WEBHOOK FOR VPS ALERTS
# ===========================================
# Deployed to: /home/murx/shared/.env.monitor
#
# Used by scripts/monitor.sh for sending alerts.
# If not set, alerts are logged to file only.
#
# To create a webhook:
#   1. Discord → Server Settings → Integrations → Webhooks
#   2. Create a new webhook in your alerts channel
#   3. Copy the webhook URL below

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
